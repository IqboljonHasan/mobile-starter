    "build:android:prod": "npx --yes eas-cli@latest build --platform android --profile production",
    "build:ios:prod": "npx --yes eas-cli@latest build --platform ios --profile production",
    "build:prod": "npx --yes eas-cli@latest build --platform all --profile production"
