{
  "expo": {
    "name": "Taqsim",
    "slug": "taqsim",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taqsim",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.iqboljonhasan.taqsim",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "uz.iqboljonhasan.taqsim",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#0F1722"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Taqsim qarzdorlarni tez qo'shish uchun kontaktlaringizni o'qiydi. Ular faqat shu qurilmada saqlanadi."
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope_400Regular.ttf",
              "./assets/fonts/Manrope_500Medium.ttf",
              "./assets/fonts/Manrope_600SemiBold.ttf",
              "./assets/fonts/Manrope_700Bold.ttf",
              "./assets/fonts/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ac9facac-e004-4a49-90ae-4b7995407a5c"
      }
    },
    "owner": "iqboljonhasan"
  }
}
